{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "types": ["bun"],
    "noEmit": true,
    "verbatimModuleSyntax": false,
    "esModuleInterop": true
  },
  "include": ["src", "test", "drizzle.config.ts"]
}
