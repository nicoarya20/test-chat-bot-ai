# Server
PORT=3000
DATABASE_URL=postgres://USER@localhost:5433/chatbot_dev
# Used only by `bun test`; must point to a separate database.
TEST_DATABASE_URL=postgres://USER@localhost:5433/chatbot_test

# Browser-facing origin (Vite dev server proxies /api to this server).
WEB_ORIGIN=http://localhost:5173
BETTER_AUTH_URL=http://localhost:5173
# openssl rand -base64 48
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated; these accounts become approved admins on first sign-in.
ADMIN_EMAILS=

# openssl rand -base64 32  (encrypts stored OpenRouter API keys)
KEY_ENCRYPTION_KEY=

# Quota: weekly reset is Monday 00:00 at this UTC offset in minutes (420 = WIB, 480 = WITA).
QUOTA_TZ_OFFSET_MINUTES=420
SESSION_WINDOW_HOURS=5

# Model provider (OpenRouter). The API key itself is added in the admin panel.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Model call tuning
CHAT_MAX_OUTPUT_TOKENS=64000
CHAT_MIN_OUTPUT_TOKENS=4096
CHAT_TIMEOUT_MS=600000
# Optional: low | medium | high. Leave unset if the chosen model doesn't support reasoning.
# CHAT_REASONING_EFFORT=medium
